{
  "extends": "@packages/typescript-config/app-web.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@hooks/*": ["hooks/*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@utils/*": ["utils/*"],
      "@typings/*": ["typings/*"],
      "@api/*": ["api/*"],
      "@constants/*": ["constants/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*", "webpack/**/*"]
}
